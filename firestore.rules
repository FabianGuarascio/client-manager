rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Solo usuarios autenticados (Firebase Authentication) pueden leer y
    // escribir clientes. El challenge pide proteger acciones sensibles con
    // Firebase Auth; no hay noción de "dueño" del registro, así que
    // cualquier usuario logueado puede operar sobre cualquier cliente.
    match /clientes/{clienteId} {
      allow read, write: if request.auth != null;
    }
  }
}
